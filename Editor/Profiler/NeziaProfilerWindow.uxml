<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Label name="placeholder" class="profiler__placeholder"
              text="Play Mode で Nezia エンジンが初期化されると表示されます" />

    <ui:VisualElement name="content" class="profiler__content">
        <!-- ── マスターメーター + Snapshot 進行 ── -->
        <ui:VisualElement class="profiler__section">
            <ui:Label text="Master" class="profiler__header" />
            <ui:VisualElement class="profiler__meter-row">
                <ui:Label text="L" class="profiler__meter-label" />
                <ui:VisualElement class="profiler__meter-track">
                    <ui:VisualElement name="meter-l" class="profiler__meter-fill" />
                </ui:VisualElement>
                <ui:Label name="meter-l-db" class="profiler__meter-db" text="-∞ dB" />
            </ui:VisualElement>
            <ui:VisualElement class="profiler__meter-row">
                <ui:Label text="R" class="profiler__meter-label" />
                <ui:VisualElement class="profiler__meter-track">
                    <ui:VisualElement name="meter-r" class="profiler__meter-fill" />
                </ui:VisualElement>
                <ui:Label name="meter-r-db" class="profiler__meter-db" text="-∞ dB" />
            </ui:VisualElement>
            <ui:VisualElement name="snapshot-row" class="profiler__snapshot-row">
                <ui:Label text="Snapshot" class="profiler__meter-label profiler__snapshot-label" />
                <ui:ProgressBar name="snapshot-progress" class="profiler__snapshot-bar"
                                low-value="0" high-value="1" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ── バス一覧 ── -->
        <ui:VisualElement class="profiler__section">
            <ui:Label name="buses-header" text="Buses" class="profiler__header" />
            <ui:VisualElement name="bus-rows" />
        </ui:VisualElement>

        <!-- ── アクティブソース一覧 ── -->
        <ui:VisualElement class="profiler__section profiler__sources-section">
            <ui:Label name="sources-header" text="Sources" class="profiler__header" />
            <ui:MultiColumnListView name="sources-list" class="profiler__sources-list">
                <ui:Columns>
                    <ui:Column name="id" title="ID" width="60" />
                    <ui:Column name="clip" title="Clip" width="160" />
                    <ui:Column name="bus" title="Bus" width="100" />
                    <ui:Column name="state" title="State" width="80" />
                    <ui:Column name="volume" title="Vol" width="50" />
                    <ui:Column name="pitch" title="Pitch" width="50" />
                    <ui:Column name="progress" title="Progress" width="170" />
                </ui:Columns>
            </ui:MultiColumnListView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
