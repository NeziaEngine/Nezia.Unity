.preview__section {
    margin-top: 8px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.25);
}

.preview__header {
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.preview__meta {
    opacity: 0.7;
    font-size: 11px;
    margin-bottom: 4px;
}

.preview__transport {
    flex-direction: row;
}

.preview__play {
    flex-grow: 1;
    height: 24px;
}

.preview__stop {
    width: 80px;
    height: 24px;
}

.preview__status {
    -unity-font-style: italic;
    opacity: 0.8;
    margin-top: 2px;
    display: none;
}

.preview__error {
    margin-top: 2px;
    display: none;
}

.preview__pick {
    display: none;
}
